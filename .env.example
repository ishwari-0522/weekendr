# WEEKENDR Environment Variables Config Template
# Copy this file to .env and fill in the values for local development.

# Flask settings
SECRET_KEY=your_secret_key_here
FLASK_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/weekendr

# Google Maps Platform APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenAI API (For Future Assistant Features)
OPENAI_API_KEY=your_openai_api_key_here

# Cloudinary (For Media storage in Memories)
CLOUDINARY_URL=your_cloudinary_url_here
